# Copier en `.env` uniquement pour un déploiement Sepolia.
# Ne jamais committer de clé privée.

SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/VOTRE_CLE
PRIVATE_KEY=0xVOTRE_CLE_PRIVEE_DE_COMPTE_DE_TEST
ETHERSCAN_API_KEY=VOTRE_CLE_ETHERSCAN

# Optionnel : active le rapport de gas dans les tests
REPORT_GAS=false
