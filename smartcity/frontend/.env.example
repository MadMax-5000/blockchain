# Frontend — variables optionnelles
# Un RPC public est utilisé par défaut pour Sepolia en lecture seule.

# RPC Sepolia personnalisé (lecture + écriture sans wallet injecté)
VITE_SEPOLIA_RPC_URL=

# RPC local si vous changez le port Hardhat
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545

# WalletConnect (non activé par défaut)
VITE_WALLETCONNECT_PROJECT_ID=
